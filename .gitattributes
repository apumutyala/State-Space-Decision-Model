# LF for everything a job ships or a shell reads (LESSONS.md L-14: CRLF *.sha256 broke sha256sum -c).
# Enforced by tests/test_jobs_lint.py (git check-attr + `git -c core.autocrlf=true archive HEAD` has no CR).
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
Dockerfile text eol=lf

# byte-exact vendored code and fixtures
fixtures/replay/** -text
third_party/** -text

# Original stopped-screen evidence must retain the recorded byte hashes.
receipts/2026-10-07-L-fact-name-screen-run1/** -text whitespace=cr-at-eol
receipts/2026-10-07-L-fact-name-screen-retry-prepared/README.md -text whitespace=cr-at-eol
# receipts are byte-exact evidence (their own sha256 lists cover the bytes): never EOL-converted on checkout
# (PR #74 review N1: a core.autocrlf=true checkout turned the tvuat MANIFEST.jsonl into CRLF)
receipts/** -text
# The failed CPU-8 package's original checksum list is preserved byte-for-byte.
receipts/2026-10-07-D-m2-cpu8-transfer-failure/package.sha256 -text whitespace=cr-at-eol
receipts/2026-10-08-D-cpu8-wake-sequence-failure/package.sha256 -text whitespace=cr-at-eol

# Preserve raw CPU-8 receipt bytes; keep authored text/checksum files LF-stable.
receipts/2026-10-08-D-m2-cpu8-validation/*.json -text whitespace=cr-at-eol
receipts/2026-10-08-D-m2-cpu8-validation/*.xml -text whitespace=cr-at-eol
receipts/2026-10-08-D-m2-cpu8-validation/*.log -text whitespace=cr-at-eol
receipts/2026-10-08-D-m2-cpu8-validation/README.md text eol=lf
receipts/2026-10-08-D-m2-cpu8-validation/SHA256SUMS.txt text eol=lf
