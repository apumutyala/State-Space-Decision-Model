# LF for everything a job ships or a shell reads (LESSONS.md L-14: CRLF *.sha256 broke sha256sum -c).
# Enforced by tests/test_jobs_lint.py (git check-attr + `git -c core.autocrlf=true archive HEAD` has no CR).
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
Dockerfile text eol=lf

# byte-exact vendored code and fixtures
fixtures/replay/** -text
third_party/** -text

# receipts are byte-exact evidence (their own sha256 lists cover the bytes): never EOL-converted on checkout
# (PR #74 review N1: a core.autocrlf=true checkout turned the tvuat MANIFEST.jsonl into CRLF)
receipts/** -text
