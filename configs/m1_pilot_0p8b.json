{
 "_comment": "m1-prep pipeline qualification on Qwen3.5-0.8B (6 attention layers at 3,7,11,15,19,23). Not a 9B claim.",
 "seed": 0, "kernel": "fla", "seq_len": 1024, "batch": 4,
 "data": {"train_max_tokens": 40000000},
